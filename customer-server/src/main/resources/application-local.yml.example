# 私有配置模板(可提交,不含真实值)
# 1. 复制本文件为 application-local.yml,填入本地值 → 本地启动(默认 profile 即 local)
# 2. 复制本文件为 application-prod.yml,填入生产值 → 打包后服务器用 --spring.profiles.active=prod 启动
# 两个目标文件都已被 .gitignore 忽略,不会提交
spring:
  datasource:
    username: your-mysql-user
    password: your-mysql-password

easemob:
  org-name: your-org
  app-name: your-app
  client-id: your-client-id
  client-secret: your-client-secret
