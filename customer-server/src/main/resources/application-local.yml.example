# 本地开发配置（可选）
# 复制本文件为 application-local.yml，填入本地环境的值，
# 并以 local profile 启动（IDEA Active profiles 填 dev,local，
# 或 -Dspring.profiles.active=dev,local）。
# 生产环境请通过环境变量 MYSQL_PASSWORD / EASEMOB_CLIENT_ID / EASEMOB_CLIENT_SECRET 注入。
spring:
  datasource:
    password: your-mysql-password

easemob:
  client-id: your-client-id
  client-secret: your-client-secret
